# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings → API). Never commit .env.local.

# Public — safe to ship to the browser, RLS protects the actual data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS entirely. Used by scripts/seed-admin.ts and
# nowhere in client-facing code. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
